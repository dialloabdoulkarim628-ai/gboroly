# ─── Gboroly — variables d'environnement (exemple) ───
# Copier vers .env.local et renseigner. NE JAMAIS committer .env réel.

# Database (PostgreSQL — Supabase en staging/prod, Docker en local)
# Supabase : URL POOLÉE (PgBouncer, port 6543) pour l'app…
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# …et connexion DIRECTE (port 5432) pour les migrations Prisma.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Local Docker (alternative) :
# DATABASE_URL="postgresql://gboroly:gboroly@localhost:5432/gboroly?schema=public"
# DIRECT_URL="postgresql://gboroly:gboroly@localhost:5432/gboroly?schema=public"

# Redis (cache + BullMQ) — Upstash en prod, Docker en local
REDIS_URL="redis://localhost:6379"

# Auth (JWT)
JWT_SECRET="change-me-dev-only"
JWT_REFRESH_SECRET="change-me-dev-only-refresh"
JWT_ACCESS_TTL="900"        # secondes (15 min)
JWT_REFRESH_TTL="2592000"   # secondes (30 jours)

# Object storage (S3-compatible — Supabase Storage en prod, MinIO en dev)
# Supabase Storage expose un endpoint S3 : https://<ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="gboroly"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Email
EMAIL_PROVIDER="console"      # console | resend | ses | smtp
EMAIL_API_KEY=""

# WhatsApp (Phase 11 — liens wa.me au MVP, pas de clé requise)
WHATSAPP_API_KEY=""

# Payments (Phase 12 — abstraction ; clés par provider)
PAYMENT_PROVIDER_KEYS=""

# API
API_PORT="4000"
API_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:3000"

# Web (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_WS_URL="http://localhost:4000"
